generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

model User {
  mfaLoginChallenge MfaLoginChallenge?
  securityNotifications SecurityNotification[]
  passwordResetSentInWindow Int @default(0)
  passwordResetWindowStartedAt DateTime?
  passwordResetLastSentAt DateTime?

  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique @db.VarChar(254)
  fullName              String                 @db.VarChar(120)
  passwordHash          String?
  socialAccounts        SocialAccount[]
  mfaSetting            MfaSetting?
  sessionVersion        Int                    @default(0)
  preferredLanguage     String                 @default("en") @db.VarChar(8)
  fontScale             Float                  @default(1)
  highContrast          Boolean                @default(false)
  onboardingStep        Int                    @default(0)
  onboardingCompletedAt DateTime?
  passwordResetCode     PasswordResetCode?
  emailVerificationCode EmailVerificationCode?
  authSessions          AuthSession[]
  securityEvents SecurityEvent[]
  emailChangeRequest EmailChangeRequest?
  googleActionChallenge GoogleActionChallenge?
  gender                Gender?
  role                  Role                   @default(PATIENT)
  avatarUrl             String?
  isActive              Boolean                @default(true)
  emailVerifiedAt       DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

enum AuthProvider {
  GOOGLE
  FACEBOOK
  APPLE
}

model SocialAccount {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  providerUserId String       @db.VarChar(255)
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

model PasswordResetCode {
  userId    String   @id @db.Uuid
  codeHash  String   @db.VarChar(64)
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MfaSetting {
  userId         String    @id @db.Uuid
  secretCipher   String?   @db.Text
  pendingCipher  String?   @db.Text
  pendingAt      DateTime?
  enabledAt      DateTime?
  recoveryHashes String[]  @default([])
  lastUsedStep   Int       @default(-1)
  attempts       Int       @default(0)
  lockedUntil    DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationCode {
  userId          String   @id @db.Uuid
  codeHash        String   @db.VarChar(64)
  attempts        Int      @default(0)
  sentAt          DateTime @default(now())
  expiresAt       DateTime
  sentInWindow    Int      @default(1)
  windowStartedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  devicePlatform String? @db.VarChar(16)
  lastActiveAt DateTime?
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique @db.VarChar(64)
  sessionVersion    Int
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedTokens UsedRefreshToken[]

  @@index([userId, revokedAt])
}

model UsedRefreshToken {
  tokenHash String   @id @db.VarChar(64)
  sessionId String   @db.Uuid
  usedAt    DateTime @default(now())

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AvatarCleanupJob {
  objectKey String   @id
  attempts  Int      @default(0)
  notBefore DateTime
  createdAt DateTime @default(now())

  @@index([notBefore])
}

enum SecurityEventType {
  SESSION_CREATED
  SESSION_REVOKED
  SIGNED_OUT
  ALL_SESSIONS_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET
  MFA_ENABLED
  MFA_DISABLED
  RECOVERY_CODES_REGENERATED
  EMAIL_CHANGED
  GOOGLE_LINKED
  GOOGLE_UNLINKED
  PASSWORD_LOGIN_FAILED
  MFA_VERIFICATION_FAILED
  REFRESH_TOKEN_REPLAY
}

model SecurityEvent {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  type      SecurityEventType
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([userId, createdAt, id])
  @@index([createdAt])
}

model EmailChangeRequest {
  userId            String   @id @db.Uuid
  requestId         String   @unique @db.Uuid
  sessionId         String   @db.Uuid
  sessionVersion    Int
  oldEmail          String   @db.VarChar(254)
  newEmail          String   @db.VarChar(254)
  oldCodeHash       String   @db.VarChar(64)
  newCodeHash       String   @db.VarChar(64)
  attempts          Int      @default(0)
  sentAt            DateTime
  expiresAt         DateTime
  sentInWindow      Int
  windowStartedAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

enum GoogleSensitiveAction {
  SET_PASSWORD
  EXPORT_DATA
  DELETE_ACCOUNT
}

model GoogleActionChallenge {
  userId          String                @id @db.Uuid
  requestId       String                @unique @db.Uuid
  sessionId       String                @db.Uuid
  sessionVersion  Int
  action          GoogleSensitiveAction
  googleSubject   String                @db.VarChar(255)
  email           String                @db.VarChar(254)
  codeHash        String                @db.VarChar(64)
  attempts        Int                   @default(0)
  sentAt          DateTime
  expiresAt       DateTime
  consumedAt      DateTime?
  sentInWindow    Int
  windowStartedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model SecurityNotification {
  language String @default("en") @db.VarChar(8)
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  recipient   String            @db.VarChar(254)
  kind        SecurityEventType
  attempts    Int               @default(0)
  notBefore   DateTime          @default(now())
  claimId     String?           @db.Uuid
  deliveredAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deliveredAt, failedAt, notBefore])
  @@index([userId])
  @@index([createdAt])
}


model MfaLoginChallenge {
  userId         String   @id @db.Uuid
  challengeId    String   @unique @db.Uuid
  sessionVersion Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model RateLimitBucket {
  key       String   @id @db.VarChar(64)
  hits      Int
  blocked   Boolean  @default(false)
  expiresAt DateTime

  @@index([expiresAt])
}
